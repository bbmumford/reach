go 1.25.0

// Local dev bridge: reach/go.mod pins ledger v0.0.6, but publisher.go writes
// ledger.Record.Partition, which exists only in the unpublished ../ledger
// working tree. Resolve ledger locally until it is published and reach bumps
// its pin.
use .

use ../ledger

// ratelimit has no release, so the v0.0.0 go.mod requires resolves to the
// package tree beside this one.
replace github.com/bbmumford/ratelimit => ../ratelimit
